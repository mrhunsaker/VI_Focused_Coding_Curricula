\NormalTok{radius\_str }\OperatorTok{=} \BuiltInTok{input}\NormalTok{(}\StringTok{"Enter the radius: "}\NormalTok{)}
\NormalTok{radius }\OperatorTok{=} \BuiltInTok{float}\NormalTok{(radius\_str)}

\NormalTok{area }\OperatorTok{=}\NormalTok{ math.pi }\OperatorTok{*}\NormalTok{ radius }\OperatorTok{**} \DecValTok{2}
\NormalTok{circumference }\OperatorTok{=} \DecValTok{2} \OperatorTok{*}\NormalTok{ math.pi }\OperatorTok{*}\NormalTok{ radius}

\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Area: }\SpecialCharTok{\{}\NormalTok{area}\SpecialCharTok{:.2f\}}\SpecialStringTok{"}\NormalTok{)}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Circumference: }\SpecialCharTok{\{}\NormalTok{circumference}\SpecialCharTok{:.2f\}}\SpecialStringTok{"}\NormalTok{)}
\end{Highlighting}
