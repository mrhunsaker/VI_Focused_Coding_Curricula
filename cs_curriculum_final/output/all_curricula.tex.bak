\subsection{Common JavaScript Error Quick
Reference}\label{common-javascript-error-quick-reference}

{\def\LTcaptype{none} % do not increment counter
\begin{longtable}[]{@{}
  >{\raggedright\arraybackslash}p{(\linewidth - 4\tabcolsep) * \real{0.3680}}
  >{\raggedright\arraybackslash}p{(\linewidth - 4\tabcolsep) * \real{0.2640}}
  >{\raggedright\arraybackslash}p{(\linewidth - 4\tabcolsep) * \real{0.3680}}@{}}
\toprule\noalign{}
\begin{minipage}[b]{\linewidth}\raggedright
Error
\end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
Common Cause
\end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
First Check
\end{minipage} \\
\midrule\noalign{}
\endhead
\bottomrule\noalign{}
\endlastfoot
\texttt{ReferenceError:\ x\ is\ not\ defined} & Typo or not declared &
Spelling; scope \\
\texttt{TypeError:\ Cannot\ read\ property\ of\ undefined} & Accessing
property on \texttt{undefined} & Which variable is undefined; optional
chaining \\
\texttt{TypeError:\ x\ is\ not\ a\ function} & Calling non-function &
\texttt{typeof\ x} before calling \\
\texttt{SyntaxError:\ Unexpected\ token} & Syntax mistake & Line number;
check brackets, commas \\
\texttt{SyntaxError:\ Cannot\ use\ import\ statement} & ES module syntax
in CommonJS & Use \texttt{require()} or add
\texttt{"type":\ "module"} \\
\texttt{Error:\ ENOENT:\ no\ such\ file\ or\ directory} & File not found
& \texttt{console.log(\_\_dirname)} and check path \\
\texttt{Error:\ EACCES:\ permission\ denied} & No write permission &
Check file permissions \\
\texttt{RangeError:\ Maximum\ call\ stack\ size\ exceeded} & Infinite
recursion & Check recursive function's base case \\
\texttt{UnhandledPromiseRejectionWarning} & Missing \texttt{await} or
\texttt{.catch()} & Add \texttt{try/catch} around \texttt{await}
calls \\
\texttt{NaN} (not an error, but wrong value) & Arithmetic on non-number
& \texttt{console.log(typeof\ variable)} before math \\
\end{longtable}
}

\subsection{Input Helper Module (Copy into every
project)}\label{input-helper-module-copy-into-every-project}

\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{// utils/input.js}
\KeywordTok{const}\NormalTok{ readline }\OperatorTok{=} \PreprocessorTok{require}\NormalTok{(}\StringTok{"readline"}\NormalTok{)}\OperatorTok{;}

\KeywordTok{const}\NormalTok{ rl }\OperatorTok{=}\NormalTok{ readline}\OperatorTok{.}\FunctionTok{createInterface}\NormalTok{(\{}
  \DataTypeTok{input}\OperatorTok{:} \BuiltInTok{process}\OperatorTok{.}\AttributeTok{stdin}\OperatorTok{,}
  \DataTypeTok{output}\OperatorTok{:} \BuiltInTok{process}\OperatorTok{.}\AttributeTok{stdout}\OperatorTok{,}
\NormalTok{\})}\OperatorTok{;}

\CommentTok{/**}
\CommentTok{ * Prompts the user and returns their response as a string.}
\CommentTok{ * }\AnnotationTok{@param}\CommentTok{ }\CommentVarTok{\{string\}}\CommentTok{ prompt {-} The question to display}
\CommentTok{ * }\AnnotationTok{@returns}\CommentTok{ \{Promise}\KeywordTok{\textless{}string\textgreater{}}\CommentTok{\} The user\textquotesingle{}s trimmed response}
\CommentTok{ */}
\KeywordTok{function} \FunctionTok{askQuestion}\NormalTok{(prompt) \{}
  \ControlFlowTok{return} \KeywordTok{new} \BuiltInTok{Promise}\NormalTok{((resolve) }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
\NormalTok{    rl}\OperatorTok{.}\FunctionTok{question}\NormalTok{(prompt}\OperatorTok{,}\NormalTok{ (answer) }\KeywordTok{=\textgreater{}} \FunctionTok{resolve}\NormalTok{(answer))}\OperatorTok{;}
\NormalTok{  \})}\OperatorTok{;}
\NormalTok{\}}

\CommentTok{/**}
\CommentTok{ * Prompts until a valid number is entered.}
\CommentTok{ * }\AnnotationTok{@param}\CommentTok{ }\CommentVarTok{\{string\}}\CommentTok{ prompt {-} The question to display}
\CommentTok{ * }\AnnotationTok{@returns}\CommentTok{ \{Promise}\KeywordTok{\textless{}number\textgreater{}}\CommentTok{\} A valid number}
\CommentTok{ */}
\KeywordTok{async} \KeywordTok{function} \FunctionTok{askNumber}\NormalTok{(prompt) \{}
  \ControlFlowTok{while}\NormalTok{ (}\KeywordTok{true}\NormalTok{) \{}
    \KeywordTok{const}\NormalTok{ input }\OperatorTok{=} \ControlFlowTok{await} \FunctionTok{askQuestion}\NormalTok{(prompt)}\OperatorTok{;}
    \KeywordTok{const}\NormalTok{ num }\OperatorTok{=} \BuiltInTok{Number}\NormalTok{(input}\OperatorTok{.}\FunctionTok{trim}\NormalTok{())}\OperatorTok{;}
    \ControlFlowTok{if}\NormalTok{ (}\OperatorTok{!}\PreprocessorTok{isNaN}\NormalTok{(num)) }\ControlFlowTok{return}\NormalTok{ num}\OperatorTok{;}
    \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Invalid input: please enter a number."}\NormalTok{)}\OperatorTok{;}
\NormalTok{  \}}
\NormalTok{\}}

\CommentTok{/**}
\CommentTok{ * Closes the readline interface. Call at the end of every program.}
\CommentTok{ */}
\KeywordTok{function} \FunctionTok{close}\NormalTok{() \{}
\NormalTok{  rl}\OperatorTok{.}\FunctionTok{close}\NormalTok{()}\OperatorTok{;}
\NormalTok{\}}

\NormalTok{module}\OperatorTok{.}\AttributeTok{exports} \OperatorTok{=}\NormalTok{ \{ askQuestion}\OperatorTok{,}\NormalTok{ askNumber}\OperatorTok{,}\NormalTok{ close \}}\OperatorTok{;}
\end{Highlighting}
