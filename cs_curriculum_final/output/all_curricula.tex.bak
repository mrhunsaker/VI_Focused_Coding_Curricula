  \end{itemize}
\item
  \begin{itemize}
  \tightlist
  \item[$\square$]
    Shift+Alt+F2 --- Accessible View
  \end{itemize}
\item
  \begin{itemize}
  \tightlist
  \item[$\square$]
    Ctrl+Shift+P --- Command Palette
  \end{itemize}
\item
  \begin{itemize}
  \tightlist
