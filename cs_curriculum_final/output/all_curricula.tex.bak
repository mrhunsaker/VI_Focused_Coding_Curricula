\subsection{Lesson 2.2: Elements of Programs --- Expressions and
Assignment}\label{lesson-2.2-elements-of-programs-expressions-and-assignment}

\subsection{Reading References}\label{reading-references-8}

\begin{itemize}
\tightlist
\item
  Zelle: Chapter 2, pages 24--26
\end{itemize}

\subsection{Expressions and
Assignment}\label{expressions-and-assignment}

An \textbf{expression} is any combination of values, variables, and
operators that evaluates to a single result. Python follows the standard
mathematical order of operations (PEMDAS).

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{result1 }\OperatorTok{=} \DecValTok{10} \OperatorTok{/} \DecValTok{2} \OperatorTok{+} \DecValTok{3}  \CommentTok{\# 10/2 is 5, then 5+3 = 8.0}
\NormalTok{message }\OperatorTok{=} \StringTok{"Python"} \OperatorTok{+} \StringTok{" "} \OperatorTok{+} \StringTok{"is fun!"}
\end{Highlighting}
\end{Shaded}

\textbf{Assignment:}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{score }\OperatorTok{=} \DecValTok{50}
\NormalTok{score }\OperatorTok{=}\NormalTok{ score }\OperatorTok{+} \DecValTok{20}  \CommentTok{\# score is now 70}
\end{Highlighting}
\end{Shaded}

\subsection{Examples}\label{examples-2}

\textbf{Example 2.2.1: Expression Evaluation}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{result1 }\OperatorTok{=} \DecValTok{10} \OperatorTok{/} \DecValTok{2} \OperatorTok{+} \DecValTok{3}
\BuiltInTok{print}\NormalTok{(}\StringTok{"Result 1:"}\NormalTok{, result1)   }\CommentTok{\# Output: Result 1: 8.0}

\NormalTok{message }\OperatorTok{=} \StringTok{"Python"} \OperatorTok{+} \StringTok{" "} \OperatorTok{+} \StringTok{"is fun!"}
\BuiltInTok{print}\NormalTok{(}\StringTok{"Message:"}\NormalTok{, message)    }\CommentTok{\# Output: Message: Python is fun!}
\end{Highlighting}
\end{Shaded}

\textbf{Example 2.2.2: Reassigning Variables}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{score }\OperatorTok{=} \DecValTok{50}
\BuiltInTok{print}\NormalTok{(}\StringTok{"Initial score:"}\NormalTok{, score)}
\NormalTok{score }\OperatorTok{=}\NormalTok{ score }\OperatorTok{+} \DecValTok{20}
\BuiltInTok{print}\NormalTok{(}\StringTok{"New score:"}\NormalTok{, score)     }\CommentTok{\# Output: New score: 70}
\end{Highlighting}
\end{Shaded}

