\section{Unit 2: Numbers, Input, and the Math
Object}\label{unit-2-numbers-input-and-the-math-object}

\begin{center}\rule{0.5\linewidth}{0.5pt}\end{center}

\subsection{Lesson 2.1: The Math
Object}\label{lesson-2.1-the-math-object}

JavaScript's built-in \texttt{Math} object provides mathematical
functions and constants:

\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{// Constants}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\ConstantTok{PI}\NormalTok{)}\OperatorTok{;} \CommentTok{// 3.14159265358979...}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\ConstantTok{E}\NormalTok{)}\OperatorTok{;} \CommentTok{// 2.71828...}

\CommentTok{// Functions}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{sqrt}\NormalTok{(}\DecValTok{25}\NormalTok{))}\OperatorTok{;} \CommentTok{// 5}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{pow}\NormalTok{(}\DecValTok{2}\OperatorTok{,} \DecValTok{10}\NormalTok{))}\OperatorTok{;} \CommentTok{// 1024}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{abs}\NormalTok{(}\OperatorTok{{-}}\FloatTok{7.5}\NormalTok{))}\OperatorTok{;} \CommentTok{// 7.5}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{ceil}\NormalTok{(}\FloatTok{4.2}\NormalTok{))}\OperatorTok{;} \CommentTok{// 5}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{floor}\NormalTok{(}\FloatTok{4.8}\NormalTok{))}\OperatorTok{;} \CommentTok{// 4}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{round}\NormalTok{(}\FloatTok{4.5}\NormalTok{))}\OperatorTok{;} \CommentTok{// 5}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{round}\NormalTok{(}\FloatTok{4.4}\NormalTok{))}\OperatorTok{;} \CommentTok{// 4}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{max}\NormalTok{(}\DecValTok{3}\OperatorTok{,} \DecValTok{7}\OperatorTok{,} \DecValTok{1}\OperatorTok{,} \DecValTok{9}\OperatorTok{,} \DecValTok{5}\NormalTok{))}\OperatorTok{;} \CommentTok{// 9}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{min}\NormalTok{(}\DecValTok{3}\OperatorTok{,} \DecValTok{7}\OperatorTok{,} \DecValTok{1}\OperatorTok{,} \DecValTok{9}\OperatorTok{,} \DecValTok{5}\NormalTok{))}\OperatorTok{;} \CommentTok{// 1}

\CommentTok{// Random number between 0 (inclusive) and 1 (exclusive)}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{random}\NormalTok{())}\OperatorTok{;}

\CommentTok{// Random integer between min and max (inclusive)}
\KeywordTok{function} \FunctionTok{randomInt}\NormalTok{(min}\OperatorTok{,}\NormalTok{ max) \{}
  \ControlFlowTok{return} \BuiltInTok{Math}\OperatorTok{.}\FunctionTok{floor}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{random}\NormalTok{() }\OperatorTok{*}\NormalTok{ (max }\OperatorTok{{-}}\NormalTok{ min }\OperatorTok{+} \DecValTok{1}\NormalTok{)) }\OperatorTok{+}\NormalTok{ min}\OperatorTok{;}
\NormalTok{\}}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\FunctionTok{randomInt}\NormalTok{(}\DecValTok{1}\OperatorTok{,} \DecValTok{6}\NormalTok{))}\OperatorTok{;} \CommentTok{// Simulates a dice roll}
\end{Highlighting}
\end{Shaded}

\begin{center}\rule{0.5\linewidth}{0.5pt}\end{center}

\subsection{Lesson 2.2: Getting User Input in
Node.js}\label{lesson-2.2-getting-user-input-in-node.js}

Getting user input in Node.js requires the built-in \texttt{readline}
module.

\subsection{\texorpdfstring{Using \texttt{readline} (Standard
Library)}{Using readline (Standard Library)}}\label{using-readline-standard-library}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ readline }\OperatorTok{=} \PreprocessorTok{require}\NormalTok{(}\StringTok{"readline"}\NormalTok{)}\OperatorTok{;}

\KeywordTok{const}\NormalTok{ rl }\OperatorTok{=}\NormalTok{ readline}\OperatorTok{.}\FunctionTok{createInterface}\NormalTok{(\{}
  \DataTypeTok{input}\OperatorTok{:} \BuiltInTok{process}\OperatorTok{.}\AttributeTok{stdin}\OperatorTok{,}
  \DataTypeTok{output}\OperatorTok{:} \BuiltInTok{process}\OperatorTok{.}\AttributeTok{stdout}\OperatorTok{,}
\NormalTok{\})}\OperatorTok{;}

\NormalTok{rl}\OperatorTok{.}\FunctionTok{question}\NormalTok{(}\StringTok{"What is your name? "}\OperatorTok{,}\NormalTok{ (name) }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Hello, }\SpecialCharTok{$\{}\NormalTok{name}\SpecialCharTok{\}}\VerbatimStringTok{!\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\NormalTok{  rl}\OperatorTok{.}\FunctionTok{close}\NormalTok{()}\OperatorTok{;}
\NormalTok{\})}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\subsection{Promisified Input (Modern
Approach)}\label{promisified-input-modern-approach}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ readline }\OperatorTok{=} \PreprocessorTok{require}\NormalTok{(}\StringTok{"readline"}\NormalTok{)}\OperatorTok{;}

\KeywordTok{const}\NormalTok{ rl }\OperatorTok{=}\NormalTok{ readline}\OperatorTok{.}\FunctionTok{createInterface}\NormalTok{(\{}
  \DataTypeTok{input}\OperatorTok{:} \BuiltInTok{process}\OperatorTok{.}\AttributeTok{stdin}\OperatorTok{,}
  \DataTypeTok{output}\OperatorTok{:} \BuiltInTok{process}\OperatorTok{.}\AttributeTok{stdout}\OperatorTok{,}
\NormalTok{\})}\OperatorTok{;}

\KeywordTok{function} \FunctionTok{askQuestion}\NormalTok{(prompt) \{}
  \ControlFlowTok{return} \KeywordTok{new} \BuiltInTok{Promise}\NormalTok{((resolve) }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
\NormalTok{    rl}\OperatorTok{.}\FunctionTok{question}\NormalTok{(prompt}\OperatorTok{,}\NormalTok{ (answer) }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
      \FunctionTok{resolve}\NormalTok{(answer)}\OperatorTok{;}
\NormalTok{    \})}\OperatorTok{;}
\NormalTok{  \})}\OperatorTok{;}
\NormalTok{\}}

\KeywordTok{async} \KeywordTok{function} \FunctionTok{main}\NormalTok{() \{}
  \KeywordTok{const}\NormalTok{ name }\OperatorTok{=} \ControlFlowTok{await} \FunctionTok{askQuestion}\NormalTok{(}\StringTok{"What is your name? "}\NormalTok{)}\OperatorTok{;}
  \KeywordTok{const}\NormalTok{ ageStr }\OperatorTok{=} \ControlFlowTok{await} \FunctionTok{askQuestion}\NormalTok{(}\StringTok{"How old are you? "}\NormalTok{)}\OperatorTok{;}
  \KeywordTok{const}\NormalTok{ age }\OperatorTok{=} \PreprocessorTok{parseInt}\NormalTok{(ageStr)}\OperatorTok{;}

  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Hello, }\SpecialCharTok{$\{}\NormalTok{name}\SpecialCharTok{\}}\VerbatimStringTok{!\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Next year you will be }\SpecialCharTok{$\{}\NormalTok{age }\OperatorTok{+} \DecValTok{1}\SpecialCharTok{\}}\VerbatimStringTok{ years old.\textasciigrave{}}\NormalTok{)}\OperatorTok{;}

\NormalTok{  rl}\OperatorTok{.}\FunctionTok{close}\NormalTok{()}\OperatorTok{;}
\NormalTok{\}}

\FunctionTok{main}\NormalTok{()}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\subsection{Helper Module for Input
(Reusable)}\label{helper-module-for-input-reusable}

Create \texttt{input.js} once and reuse across projects:

\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{// input.js {-}{-}{-} save this file in your project}
\KeywordTok{const}\NormalTok{ readline }\OperatorTok{=} \PreprocessorTok{require}\NormalTok{(}\StringTok{"readline"}\NormalTok{)}\OperatorTok{;}

\KeywordTok{const}\NormalTok{ rl }\OperatorTok{=}\NormalTok{ readline}\OperatorTok{.}\FunctionTok{createInterface}\NormalTok{(\{}
  \DataTypeTok{input}\OperatorTok{:} \BuiltInTok{process}\OperatorTok{.}\AttributeTok{stdin}\OperatorTok{,}
  \DataTypeTok{output}\OperatorTok{:} \BuiltInTok{process}\OperatorTok{.}\AttributeTok{stdout}\OperatorTok{,}
\NormalTok{\})}\OperatorTok{;}

\KeywordTok{function} \FunctionTok{askQuestion}\NormalTok{(prompt) \{}
  \ControlFlowTok{return} \KeywordTok{new} \BuiltInTok{Promise}\NormalTok{((resolve) }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
\NormalTok{    rl}\OperatorTok{.}\FunctionTok{question}\NormalTok{(prompt}\OperatorTok{,}\NormalTok{ resolve)}\OperatorTok{;}
\NormalTok{  \})}\OperatorTok{;}
\NormalTok{\}}

\KeywordTok{function} \FunctionTok{close}\NormalTok{() \{}
\NormalTok{  rl}\OperatorTok{.}\FunctionTok{close}\NormalTok{()}\OperatorTok{;}
\NormalTok{\}}

\NormalTok{module}\OperatorTok{.}\AttributeTok{exports} \OperatorTok{=}\NormalTok{ \{ askQuestion}\OperatorTok{,}\NormalTok{ close \}}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

Usage in your main file:

\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{// main.js}
\KeywordTok{const}\NormalTok{ \{ askQuestion}\OperatorTok{,}\NormalTok{ close \} }\OperatorTok{=} \PreprocessorTok{require}\NormalTok{(}\StringTok{"./input"}\NormalTok{)}\OperatorTok{;}

\KeywordTok{async} \KeywordTok{function} \FunctionTok{main}\NormalTok{() \{}
  \KeywordTok{const}\NormalTok{ name }\OperatorTok{=} \ControlFlowTok{await} \FunctionTok{askQuestion}\NormalTok{(}\StringTok{"Enter your name: "}\NormalTok{)}\OperatorTok{;}
  \KeywordTok{const}\NormalTok{ numStr }\OperatorTok{=} \ControlFlowTok{await} \FunctionTok{askQuestion}\NormalTok{(}\StringTok{"Enter a number: "}\NormalTok{)}\OperatorTok{;}
  \KeywordTok{const}\NormalTok{ num }\OperatorTok{=} \PreprocessorTok{parseFloat}\NormalTok{(numStr)}\OperatorTok{;}

  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Hello, }\SpecialCharTok{$\{}\NormalTok{name}\SpecialCharTok{\}}\VerbatimStringTok{!\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Your number squared is: }\SpecialCharTok{$\{}\NormalTok{num }\OperatorTok{**} \DecValTok{2}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}

  \FunctionTok{close}\NormalTok{()}\OperatorTok{;}
\NormalTok{\}}

\FunctionTok{main}\NormalTok{()}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\subsection{Examples}\label{examples-15}

\textbf{Example 2.2.1: Temperature Converter}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ \{ askQuestion}\OperatorTok{,}\NormalTok{ close \} }\OperatorTok{=} \PreprocessorTok{require}\NormalTok{(}\StringTok{"./input"}\NormalTok{)}\OperatorTok{;}

\KeywordTok{async} \KeywordTok{function} \FunctionTok{main}\NormalTok{() \{}
  \KeywordTok{const}\NormalTok{ fahrenheitStr }\OperatorTok{=} \ControlFlowTok{await} \FunctionTok{askQuestion}\NormalTok{(}\StringTok{"Enter temperature in Fahrenheit: "}\NormalTok{)}\OperatorTok{;}
  \KeywordTok{const}\NormalTok{ fahrenheit }\OperatorTok{=} \PreprocessorTok{parseFloat}\NormalTok{(fahrenheitStr)}\OperatorTok{;}

  \KeywordTok{const}\NormalTok{ celsius }\OperatorTok{=}\NormalTok{ ((fahrenheit }\OperatorTok{{-}} \DecValTok{32}\NormalTok{) }\OperatorTok{*} \DecValTok{5}\NormalTok{) }\OperatorTok{/} \DecValTok{9}\OperatorTok{;}

  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}}\SpecialCharTok{$\{}\NormalTok{fahrenheit}\SpecialCharTok{\}}\VerbatimStringTok{°F is }\SpecialCharTok{$\{}\NormalTok{celsius}\OperatorTok{.}\FunctionTok{toFixed}\NormalTok{(}\DecValTok{1}\NormalTok{)}\SpecialCharTok{\}}\VerbatimStringTok{°C\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
  \FunctionTok{close}\NormalTok{()}\OperatorTok{;}
\NormalTok{\}}

\FunctionTok{main}\NormalTok{()}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\textbf{Example 2.2.2: Circle Calculator}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ \{ askQuestion}\OperatorTok{,}\NormalTok{ close \} }\OperatorTok{=} \PreprocessorTok{require}\NormalTok{(}\StringTok{"./input"}\NormalTok{)}\OperatorTok{;}

\KeywordTok{async} \KeywordTok{function} \FunctionTok{main}\NormalTok{() \{}
  \KeywordTok{const}\NormalTok{ radiusStr }\OperatorTok{=} \ControlFlowTok{await} \FunctionTok{askQuestion}\NormalTok{(}\StringTok{"Enter the radius: "}\NormalTok{)}\OperatorTok{;}
  \KeywordTok{const}\NormalTok{ radius }\OperatorTok{=} \PreprocessorTok{parseFloat}\NormalTok{(radiusStr)}\OperatorTok{;}

  \KeywordTok{const}\NormalTok{ area }\OperatorTok{=} \BuiltInTok{Math}\OperatorTok{.}\ConstantTok{PI} \OperatorTok{*}\NormalTok{ radius }\OperatorTok{**} \DecValTok{2}\OperatorTok{;}
  \KeywordTok{const}\NormalTok{ circumference }\OperatorTok{=} \DecValTok{2} \OperatorTok{*} \BuiltInTok{Math}\OperatorTok{.}\ConstantTok{PI} \OperatorTok{*}\NormalTok{ radius}\OperatorTok{;}

  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Area: }\SpecialCharTok{$\{}\NormalTok{area}\OperatorTok{.}\FunctionTok{toFixed}\NormalTok{(}\DecValTok{2}\NormalTok{)}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Circumference: }\SpecialCharTok{$\{}\NormalTok{circumference}\OperatorTok{.}\FunctionTok{toFixed}\NormalTok{(}\DecValTok{2}\NormalTok{)}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
  \FunctionTok{close}\NormalTok{()}\OperatorTok{;}
\NormalTok{\}}

\FunctionTok{main}\NormalTok{()}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\subsection{Skills Checklist}\label{skills-checklist-56}

\begin{itemize}
\tightlist
\item[$\square$]
  I can use \texttt{Math} object methods and constants.
\item[$\square$]
  I can get user input using the \texttt{readline} module.
\item[$\square$]
  I understand \texttt{async}/\texttt{await} for asynchronous input.
\item[$\square$]
  I can convert string input to numbers using \texttt{parseInt()} and
  \texttt{parseFloat()}.
\end{itemize}

