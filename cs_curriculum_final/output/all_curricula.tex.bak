\subsection{Lesson 1.3: Variables and Simple Data
Types}\label{lesson-1.3-variables-and-simple-data-types-1}

\subsection{Reading References}\label{reading-references-6}

\begin{itemize}
\tightlist
\item
  Zelle: Chapter 2, pages 24--26
\item
  Matthes: Chapter 2, pages 15--32
\end{itemize}

\subsection{What Is a Variable?}\label{what-is-a-variable}

A \textbf{variable} is a name that refers to a value stored in the
computer's memory. The \textbf{assignment operator} \texttt{=} creates a
connection between a name and a value.

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{age }\OperatorTok{=} \DecValTok{25}
\NormalTok{name }\OperatorTok{=} \StringTok{"Alice"}
\NormalTok{height }\OperatorTok{=} \FloatTok{5.6}
\end{Highlighting}
\end{Shaded}

\textbf{Rules for variable names:}

\begin{itemize}
\tightlist
\item
  Must start with a letter or underscore
\item
  Can only contain letters, digits, and underscores
\item
  Are case-sensitive (\texttt{age} is different from \texttt{Age})
\item
  Cannot be a Python keyword (\texttt{if}, \texttt{for}, \texttt{while},
  etc.)
\end{itemize}

\textbf{Best practices:}

\begin{itemize}
\tightlist
\item
  Use descriptive names: \texttt{student\_count}, not \texttt{sc}
\item
  Use lowercase with underscores: \texttt{first\_name}
\end{itemize}

\subsection{Essential Data Types}\label{essential-data-types}

{\def\LTcaptype{none} % do not increment counter
\begin{longtable}[]{@{}lll@{}}
\toprule\noalign{}
Type & Description & Examples \\
\midrule\noalign{}
\endhead
\bottomrule\noalign{}
\endlastfoot
\texttt{str} (String) & Text data & \texttt{"hello"},
\texttt{"Python"} \\
\texttt{int} (Integer) & Whole numbers & \texttt{10}, \texttt{-5},
\texttt{0} \\
\texttt{float} (Float) & Numbers with decimals & \texttt{3.14},
\texttt{9.99} \\
\texttt{bool} (Boolean) & True or False & \texttt{True},
\texttt{False} \\
\end{longtable}
}

\subsection{Examples}\label{examples-1}

\textbf{Example 1.3.1: Storing and Printing a String}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{student\_name }\OperatorTok{=} \StringTok{"Charlie"}
\BuiltInTok{print}\NormalTok{(}\StringTok{"Hello, "} \OperatorTok{+}\NormalTok{ student\_name }\OperatorTok{+} \StringTok{"!"}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

Output:

\begin{verbatim}
Hello, Charlie!
\end{verbatim}

\textbf{Example 1.3.2: Storing and Printing Numbers}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{apple\_count }\OperatorTok{=} \DecValTok{5}
\NormalTok{orange\_count }\OperatorTok{=} \DecValTok{3}
\NormalTok{total\_fruit }\OperatorTok{=}\NormalTok{ apple\_count }\OperatorTok{+}\NormalTok{ orange\_count}
\BuiltInTok{print}\NormalTok{(}\StringTok{"You have"}\NormalTok{, total\_fruit, }\StringTok{"fruits in total."}\NormalTok{)}

\NormalTok{price\_per\_item }\OperatorTok{=} \FloatTok{2.50}
\NormalTok{quantity }\OperatorTok{=} \DecValTok{4}
\NormalTok{total\_cost }\OperatorTok{=}\NormalTok{ price\_per\_item }\OperatorTok{*}\NormalTok{ quantity}
\BuiltInTok{print}\NormalTok{(}\StringTok{"The total cost is:"}\NormalTok{, total\_cost)}
\end{Highlighting}
\end{Shaded}

Output:

\begin{verbatim}
You have 8 fruits in total.
The total cost is: 10.0
\end{verbatim}

\subsection{Common Errors}\label{common-errors}

\begin{Shaded}
\begin{Highlighting}[]
\DecValTok{2}\ErrorTok{nd\_number} \OperatorTok{=} \DecValTok{10}         \CommentTok{\# Invalid variable name {-}{-}{-} starts with digit}
\BuiltInTok{print}\NormalTok{(}\StringTok{"Result: "} \OperatorTok{+} \DecValTok{42}\NormalTok{)  }\CommentTok{\# TypeError {-}{-}{-} can\textquotesingle{}t concatenate str and int}
\end{Highlighting}
\end{Shaded}

\subsection{Activities}\label{activities-2}

\textbf{Activity 1.3.1: Personal Information Variables}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{my\_name }\OperatorTok{=} \StringTok{"Jamie"}
\NormalTok{favorite\_number }\OperatorTok{=} \DecValTok{7}
\NormalTok{height\_in\_meters }\OperatorTok{=} \FloatTok{1.75}
\NormalTok{favorite\_food }\OperatorTok{=} \StringTok{"pizza"}

\BuiltInTok{print}\NormalTok{(}\StringTok{"My name is:"}\NormalTok{, my\_name)}
\BuiltInTok{print}\NormalTok{(}\StringTok{"My favorite number is:"}\NormalTok{, favorite\_number)}
\BuiltInTok{print}\NormalTok{(}\StringTok{"My height is:"}\NormalTok{, height\_in\_meters, }\StringTok{"meters"}\NormalTok{)}
\BuiltInTok{print}\NormalTok{(}\StringTok{"My favorite food is:"}\NormalTok{, favorite\_food)}
\end{Highlighting}
\end{Shaded}

\textbf{Activity 1.3.2: Simple Math Challenge}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{num1 }\OperatorTok{=} \DecValTok{15}
\NormalTok{num2 }\OperatorTok{=} \DecValTok{7}
\NormalTok{sum\_result }\OperatorTok{=}\NormalTok{ num1 }\OperatorTok{+}\NormalTok{ num2}
\NormalTok{difference }\OperatorTok{=}\NormalTok{ num1 }\OperatorTok{{-}}\NormalTok{ num2}
\NormalTok{product }\OperatorTok{=}\NormalTok{ num1 }\OperatorTok{*}\NormalTok{ num2}
\NormalTok{quotient }\OperatorTok{=}\NormalTok{ num1 }\OperatorTok{/}\NormalTok{ num2}

\BuiltInTok{print}\NormalTok{(}\StringTok{"Sum:"}\NormalTok{, sum\_result)}
\BuiltInTok{print}\NormalTok{(}\StringTok{"Difference:"}\NormalTok{, difference)}
\BuiltInTok{print}\NormalTok{(}\StringTok{"Product:"}\NormalTok{, product)}
\BuiltInTok{print}\NormalTok{(}\StringTok{"Quotient:"}\NormalTok{, quotient)}
\end{Highlighting}
\end{Shaded}

