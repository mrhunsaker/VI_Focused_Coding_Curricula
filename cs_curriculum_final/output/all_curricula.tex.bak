\subsection{Lesson 9.5: Testing with
Jest}\label{lesson-9.5-testing-with-jest}

\subsection{Setting Up Jest}\label{setting-up-jest}

\begin{Shaded}
\begin{Highlighting}[]
\ExtensionTok{npm}\NormalTok{ init }\AttributeTok{{-}y}
\ExtensionTok{npm}\NormalTok{ install }\AttributeTok{{-}{-}save{-}dev}\NormalTok{ jest}
\end{Highlighting}
\end{Shaded}

Add to \texttt{package.json}:

\begin{Shaded}
\begin{Highlighting}[]
\FunctionTok{\{}
  \DataTypeTok{"scripts"}\FunctionTok{:} \FunctionTok{\{}
    \DataTypeTok{"test"}\FunctionTok{:} \StringTok{"jest"}
  \FunctionTok{\}}
\FunctionTok{\}}
\end{Highlighting}
\end{Shaded}

\subsection{Writing Tests}\label{writing-tests}

\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{// math.js}
\KeywordTok{const}\NormalTok{ add }\OperatorTok{=}\NormalTok{ (a}\OperatorTok{,}\NormalTok{ b) }\KeywordTok{=\textgreater{}}\NormalTok{ a }\OperatorTok{+}\NormalTok{ b}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ getGrade }\OperatorTok{=}\NormalTok{ (score) }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
  \ControlFlowTok{if}\NormalTok{ (score }\OperatorTok{\textgreater{}=} \DecValTok{90}\NormalTok{) }\ControlFlowTok{return} \StringTok{"A"}\OperatorTok{;}
  \ControlFlowTok{if}\NormalTok{ (score }\OperatorTok{\textgreater{}=} \DecValTok{80}\NormalTok{) }\ControlFlowTok{return} \StringTok{"B"}\OperatorTok{;}
  \ControlFlowTok{if}\NormalTok{ (score }\OperatorTok{\textgreater{}=} \DecValTok{70}\NormalTok{) }\ControlFlowTok{return} \StringTok{"C"}\OperatorTok{;}
  \ControlFlowTok{return} \StringTok{"F"}\OperatorTok{;}
\NormalTok{\}}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ circleArea }\OperatorTok{=}\NormalTok{ (radius) }\KeywordTok{=\textgreater{}} \BuiltInTok{Math}\OperatorTok{.}\ConstantTok{PI} \OperatorTok{*}\NormalTok{ radius }\OperatorTok{**} \DecValTok{2}\OperatorTok{;}

\NormalTok{module}\OperatorTok{.}\AttributeTok{exports} \OperatorTok{=}\NormalTok{ \{ add}\OperatorTok{,}\NormalTok{ getGrade}\OperatorTok{,}\NormalTok{ circleArea \}}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{// math.test.js}
\KeywordTok{const}\NormalTok{ \{ add}\OperatorTok{,}\NormalTok{ getGrade}\OperatorTok{,}\NormalTok{ circleArea \} }\OperatorTok{=} \PreprocessorTok{require}\NormalTok{(}\StringTok{"./math"}\NormalTok{)}\OperatorTok{;}

\FunctionTok{describe}\NormalTok{(}\StringTok{"add function"}\OperatorTok{,}\NormalTok{ () }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
  \FunctionTok{test}\NormalTok{(}\StringTok{"adds two positive numbers"}\OperatorTok{,}\NormalTok{ () }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
    \FunctionTok{expect}\NormalTok{(}\FunctionTok{add}\NormalTok{(}\DecValTok{5}\OperatorTok{,} \DecValTok{3}\NormalTok{))}\OperatorTok{.}\FunctionTok{toBe}\NormalTok{(}\DecValTok{8}\NormalTok{)}\OperatorTok{;}
\NormalTok{  \})}\OperatorTok{;}

  \FunctionTok{test}\NormalTok{(}\StringTok{"adds negative numbers"}\OperatorTok{,}\NormalTok{ () }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
    \FunctionTok{expect}\NormalTok{(}\FunctionTok{add}\NormalTok{(}\OperatorTok{{-}}\DecValTok{5}\OperatorTok{,} \OperatorTok{{-}}\DecValTok{3}\NormalTok{))}\OperatorTok{.}\FunctionTok{toBe}\NormalTok{(}\OperatorTok{{-}}\DecValTok{8}\NormalTok{)}\OperatorTok{;}
\NormalTok{  \})}\OperatorTok{;}

  \FunctionTok{test}\NormalTok{(}\StringTok{"adds zero"}\OperatorTok{,}\NormalTok{ () }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
    \FunctionTok{expect}\NormalTok{(}\FunctionTok{add}\NormalTok{(}\DecValTok{0}\OperatorTok{,} \DecValTok{7}\NormalTok{))}\OperatorTok{.}\FunctionTok{toBe}\NormalTok{(}\DecValTok{7}\NormalTok{)}\OperatorTok{;}
\NormalTok{  \})}\OperatorTok{;}
\NormalTok{\})}\OperatorTok{;}

\FunctionTok{describe}\NormalTok{(}\StringTok{"getGrade function"}\OperatorTok{,}\NormalTok{ () }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
  \FunctionTok{test}\NormalTok{(}\StringTok{"returns A for score \textgreater{}= 90"}\OperatorTok{,}\NormalTok{ () }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
    \FunctionTok{expect}\NormalTok{(}\FunctionTok{getGrade}\NormalTok{(}\DecValTok{95}\NormalTok{))}\OperatorTok{.}\FunctionTok{toBe}\NormalTok{(}\StringTok{"A"}\NormalTok{)}\OperatorTok{;}
    \FunctionTok{expect}\NormalTok{(}\FunctionTok{getGrade}\NormalTok{(}\DecValTok{90}\NormalTok{))}\OperatorTok{.}\FunctionTok{toBe}\NormalTok{(}\StringTok{"A"}\NormalTok{)}\OperatorTok{;}
\NormalTok{  \})}\OperatorTok{;}

  \FunctionTok{test}\NormalTok{(}\StringTok{"returns B for score 80{-}89"}\OperatorTok{,}\NormalTok{ () }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
    \FunctionTok{expect}\NormalTok{(}\FunctionTok{getGrade}\NormalTok{(}\DecValTok{85}\NormalTok{))}\OperatorTok{.}\FunctionTok{toBe}\NormalTok{(}\StringTok{"B"}\NormalTok{)}\OperatorTok{;}
\NormalTok{  \})}\OperatorTok{;}

  \FunctionTok{test}\NormalTok{(}\StringTok{"returns F for score \textless{} 60"}\OperatorTok{,}\NormalTok{ () }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
    \FunctionTok{expect}\NormalTok{(}\FunctionTok{getGrade}\NormalTok{(}\DecValTok{55}\NormalTok{))}\OperatorTok{.}\FunctionTok{toBe}\NormalTok{(}\StringTok{"F"}\NormalTok{)}\OperatorTok{;}
\NormalTok{  \})}\OperatorTok{;}
\NormalTok{\})}\OperatorTok{;}

\FunctionTok{describe}\NormalTok{(}\StringTok{"circleArea function"}\OperatorTok{,}\NormalTok{ () }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
  \FunctionTok{test}\NormalTok{(}\StringTok{"calculates area of circle"}\OperatorTok{,}\NormalTok{ () }\KeywordTok{=\textgreater{}}\NormalTok{ \{}
    \FunctionTok{expect}\NormalTok{(}\FunctionTok{circleArea}\NormalTok{(}\DecValTok{5}\NormalTok{))}\OperatorTok{.}\FunctionTok{toBeCloseTo}\NormalTok{(}\FloatTok{78.54}\OperatorTok{,} \DecValTok{1}\NormalTok{)}\OperatorTok{;}
