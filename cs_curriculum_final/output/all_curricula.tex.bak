\section{Unit 3: Control Flow --- Decisions and
Loops}\label{unit-3-control-flow-decisions-and-loops-2}

\begin{center}\rule{0.5\linewidth}{0.5pt}\end{center}

\subsection{\texorpdfstring{Lesson 3.1: Boolean Expressions and
\texttt{if}
Statements}{Lesson 3.1: Boolean Expressions and if Statements}}\label{lesson-3.1-boolean-expressions-and-if-statements-1}

\subsection{Comparison Operators}\label{comparison-operators}

{\def\LTcaptype{none} % do not increment counter
\begin{longtable}[]{@{}lll@{}}
\toprule\noalign{}
Operator & Meaning & Note \\
\midrule\noalign{}
\endhead
\bottomrule\noalign{}
\endlastfoot
\texttt{===} & Strict equal & Checks value AND type (preferred) \\
\texttt{!==} & Strict not equal & Checks value AND type (preferred) \\
\texttt{==} & Loose equal & Type coercion (avoid) \\
\texttt{!=} & Loose not equal & Type coercion (avoid) \\
\texttt{\textless{}} & Less than & \\
\texttt{\textgreater{}} & Greater than & \\
\texttt{\textless{}=} & Less than or equal & \\
\texttt{\textgreater{}=} & Greater than or equal & \\
\end{longtable}
}

\textbf{Always use \texttt{===} and \texttt{!==}} --- \texttt{==} does
unexpected type conversions.

\subsection{Logical Operators}\label{logical-operators}

{\def\LTcaptype{none} % do not increment counter
\begin{longtable}[]{@{}lll@{}}
\toprule\noalign{}
Operator & Meaning & Example \\
\midrule\noalign{}
\endhead
\bottomrule\noalign{}
\endlastfoot
\texttt{\&\&} & AND & \texttt{age\ \textgreater{}=\ 18\ \&\&\ hasId} \\
\texttt{\textbackslash{}\textbar{}\textbackslash{}\textbar{}} & OR &
\texttt{day\ ===\ \textquotesingle{}Sat\textquotesingle{}\ \textbackslash{}\textbar{}\textbackslash{}\textbar{}\ day\ ===\ \textquotesingle{}Sun\textquotesingle{}} \\
\texttt{!} & NOT & \texttt{!isRaining} \\
\end{longtable}
}

\subsection{\texorpdfstring{\texttt{if-else\ if-else}}{if-else if-else}}\label{if-else-if-else}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ score }\OperatorTok{=} \DecValTok{85}\OperatorTok{;}

\ControlFlowTok{if}\NormalTok{ (score }\OperatorTok{\textgreater{}=} \DecValTok{90}\NormalTok{) \{}
  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Grade: A"}\NormalTok{)}\OperatorTok{;}
\NormalTok{\} }\ControlFlowTok{else} \ControlFlowTok{if}\NormalTok{ (score }\OperatorTok{\textgreater{}=} \DecValTok{80}\NormalTok{) \{}
  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Grade: B"}\NormalTok{)}\OperatorTok{;}
\NormalTok{\} }\ControlFlowTok{else} \ControlFlowTok{if}\NormalTok{ (score }\OperatorTok{\textgreater{}=} \DecValTok{70}\NormalTok{) \{}
  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Grade: C"}\NormalTok{)}\OperatorTok{;}
\NormalTok{\} }\ControlFlowTok{else}\NormalTok{ \{}
  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Grade: F"}\NormalTok{)}\OperatorTok{;}
\NormalTok{\}}
\end{Highlighting}
\end{Shaded}

\subsection{Ternary Operator}\label{ternary-operator}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ age }\OperatorTok{=} \DecValTok{20}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ status }\OperatorTok{=}\NormalTok{ age }\OperatorTok{\textgreater{}=} \DecValTok{18} \OperatorTok{?} \StringTok{"adult"} \OperatorTok{:} \StringTok{"minor"}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(status)}\OperatorTok{;} \CommentTok{// "adult"}
\end{Highlighting}
\end{Shaded}

\subsection{\texorpdfstring{\texttt{switch}
Statement}{switch Statement}}\label{switch-statement}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ day }\OperatorTok{=} \StringTok{"Wednesday"}\OperatorTok{;}
\ControlFlowTok{switch}\NormalTok{ (day) \{}
  \ControlFlowTok{case} \StringTok{"Monday"}\OperatorTok{:}
  \ControlFlowTok{case} \StringTok{"Tuesday"}\OperatorTok{:}
  \ControlFlowTok{case} \StringTok{"Wednesday"}\OperatorTok{:}
  \ControlFlowTok{case} \StringTok{"Thursday"}\OperatorTok{:}
  \ControlFlowTok{case} \StringTok{"Friday"}\OperatorTok{:}
    \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Weekday"}\NormalTok{)}\OperatorTok{;}
    \ControlFlowTok{break}\OperatorTok{;}
  \ControlFlowTok{case} \StringTok{"Saturday"}\OperatorTok{:}
  \ControlFlowTok{case} \StringTok{"Sunday"}\OperatorTok{:}
    \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Weekend"}\NormalTok{)}\OperatorTok{;}
    \ControlFlowTok{break}\OperatorTok{;}
  \ControlFlowTok{default}\OperatorTok{:}
    \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Unknown day"}\NormalTok{)}\OperatorTok{;}
\NormalTok{\}}
\end{Highlighting}
\end{Shaded}

\subsection{Truthy and Falsy Values}\label{truthy-and-falsy-values}

In JavaScript, the following values are \textbf{falsy} (evaluate to
\texttt{false} in conditions):

\begin{itemize}
\tightlist
\item
  \texttt{false}, \texttt{0}, \texttt{""} (empty string), \texttt{null},
  \texttt{undefined}, \texttt{NaN}
\end{itemize}

Everything else is \textbf{truthy}.

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ name }\OperatorTok{=} \StringTok{""}\OperatorTok{;}
\ControlFlowTok{if}\NormalTok{ (name) \{}
  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Name is set"}\NormalTok{)}\OperatorTok{;}
\NormalTok{\} }\ControlFlowTok{else}\NormalTok{ \{}
  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Name is empty"}\NormalTok{)}\OperatorTok{;} \CommentTok{// This runs}
\NormalTok{\}}
\end{Highlighting}
\end{Shaded}

\subsection{Examples}\label{examples-16}

\textbf{Example 3.1.1: Grade Calculator}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ \{ askQuestion}\OperatorTok{,}\NormalTok{ close \} }\OperatorTok{=} \PreprocessorTok{require}\NormalTok{(}\StringTok{"./input"}\NormalTok{)}\OperatorTok{;}

\KeywordTok{async} \KeywordTok{function} \FunctionTok{main}\NormalTok{() \{}
  \KeywordTok{const}\NormalTok{ scoreStr }\OperatorTok{=} \ControlFlowTok{await} \FunctionTok{askQuestion}\NormalTok{(}\StringTok{"Enter your score (0{-}100): "}\NormalTok{)}\OperatorTok{;}
  \KeywordTok{const}\NormalTok{ score }\OperatorTok{=} \PreprocessorTok{parseInt}\NormalTok{(scoreStr)}\OperatorTok{;}

  \KeywordTok{let}\NormalTok{ grade}\OperatorTok{;}
  \ControlFlowTok{if}\NormalTok{ (score }\OperatorTok{\textgreater{}=} \DecValTok{90}\NormalTok{) grade }\OperatorTok{=} \StringTok{"A"}\OperatorTok{;}
  \ControlFlowTok{else} \ControlFlowTok{if}\NormalTok{ (score }\OperatorTok{\textgreater{}=} \DecValTok{80}\NormalTok{) grade }\OperatorTok{=} \StringTok{"B"}\OperatorTok{;}
  \ControlFlowTok{else} \ControlFlowTok{if}\NormalTok{ (score }\OperatorTok{\textgreater{}=} \DecValTok{70}\NormalTok{) grade }\OperatorTok{=} \StringTok{"C"}\OperatorTok{;}
  \ControlFlowTok{else} \ControlFlowTok{if}\NormalTok{ (score }\OperatorTok{\textgreater{}=} \DecValTok{60}\NormalTok{) grade }\OperatorTok{=} \StringTok{"D"}\OperatorTok{;}
  \ControlFlowTok{else}\NormalTok{ grade }\OperatorTok{=} \StringTok{"F"}\OperatorTok{;}

  \BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Your grade: }\SpecialCharTok{$\{}\NormalTok{grade}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
  \FunctionTok{close}\NormalTok{()}\OperatorTok{;}
\NormalTok{\}}

\FunctionTok{main}\NormalTok{()}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\subsection{Skills Checklist}\label{skills-checklist-57}

\begin{itemize}
\tightlist
\item[$\square$]
  I use \texttt{===} and \texttt{!==} for comparisons in JavaScript.
\item[$\square$]
  I can write \texttt{if}, \texttt{else\ if}, and \texttt{else}
  statements.
\item[$\square$]
  I understand truthy and falsy values.
\item[$\square$]
  I can write a \texttt{switch} statement.
\end{itemize}

