File}\label{creating-your-first-python-file}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\tightlist
\item
  Ensure Explorer is focused: \texttt{Ctrl\ +\ Shift\ +\ E}.
\item
  Create new file: \texttt{Ctrl\ +\ N}.
\item
  Save: \texttt{Ctrl\ +\ S}. Name it \texttt{hello.py}.
\item
  Type:
\end{enumerate}

\begin{Shaded}
\begin{Highlighting}[]
\BuiltInTok{print}\NormalTok{(}\StringTok{"Hello from VS Code!"}\NormalTok{)}
