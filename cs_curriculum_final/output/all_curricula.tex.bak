\section{Unit 1: Foundations --- Getting Started with
JavaScript}\label{unit-1-foundations-getting-started-with-javascript}

\subsection{Overview}\label{overview-12}

This unit covers JavaScript fundamentals: variables, data types, and
basic output.

\begin{center}\rule{0.5\linewidth}{0.5pt}\end{center}

\subsection{Lesson 1.1: Welcome to Computer
Science}\label{lesson-1.1-welcome-to-computer-science-2}

\emph{(See Python Unit 1.1 for conceptual content --- hardware,
software, algorithms, and problem-solving are language-agnostic.)}

\subsection{JavaScript's Role}\label{javascripts-role}

JavaScript was created by Brendan Eich at Netscape in 1995. Originally
just for web browsers, it now runs everywhere thanks to Node.js (2009).

\begin{center}\rule{0.5\linewidth}{0.5pt}\end{center}

\subsection{Lesson 1.2: Variables and
Output}\label{lesson-1.2-variables-and-output}

\subsection{\texorpdfstring{\texttt{console.log()}}{console.log()}}\label{console.log}

\begin{Shaded}
\begin{Highlighting}[]
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Hello, World!"}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\DecValTok{42}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\KeywordTok{true}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Value:"}\OperatorTok{,} \DecValTok{42}\OperatorTok{,} \StringTok{"and"}\OperatorTok{,} \StringTok{"text"}\NormalTok{)}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\subsection{Declaring Variables}\label{declaring-variables}

JavaScript has three ways to declare variables:

{\def\LTcaptype{none} % do not increment counter
\begin{longtable}[]{@{}
  >{\raggedright\arraybackslash}p{(\linewidth - 6\tabcolsep) * \real{0.1129}}
  >{\raggedright\arraybackslash}p{(\linewidth - 6\tabcolsep) * \real{0.1290}}
  >{\raggedright\arraybackslash}p{(\linewidth - 6\tabcolsep) * \real{0.1935}}
  >{\raggedright\arraybackslash}p{(\linewidth - 6\tabcolsep) * \real{0.5645}}@{}}
\toprule\noalign{}
\begin{minipage}[b]{\linewidth}\raggedright
Keyword
\end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
Scope
\end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
Reassignable
\end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
Use When
\end{minipage} \\
\midrule\noalign{}
\endhead
\bottomrule\noalign{}
\endlastfoot
\texttt{const} & Block & No & Value won't change (default choice) \\
\texttt{let} & Block & Yes & Value will change \\
\texttt{var} & Function & Yes & Legacy --- avoid in modern code \\
\end{longtable}
}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const} \ConstantTok{PI} \OperatorTok{=} \FloatTok{3.14159}\OperatorTok{;} \CommentTok{// Cannot be reassigned}
\KeywordTok{let}\NormalTok{ score }\OperatorTok{=} \DecValTok{100}\OperatorTok{;} \CommentTok{// Can change}
\NormalTok{score }\OperatorTok{=} \DecValTok{150}\OperatorTok{;} \CommentTok{// OK}

\CommentTok{// var is function{-}scoped (legacy)}
\KeywordTok{var}\NormalTok{ oldWay }\OperatorTok{=} \StringTok{"avoid this"}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\textbf{Best practice:} Use \texttt{const} by default; use \texttt{let}
only when you need to reassign.

\subsection{Template Literals}\label{template-literals}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ name }\OperatorTok{=} \StringTok{"Alice"}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ age }\OperatorTok{=} \DecValTok{15}\OperatorTok{;}

\CommentTok{// Template literal (backticks {-}{-}{-} preferred)}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Hello, }\SpecialCharTok{$\{}\NormalTok{name}\SpecialCharTok{\}}\VerbatimStringTok{! You are }\SpecialCharTok{$\{}\NormalTok{age}\SpecialCharTok{\}}\VerbatimStringTok{ years old.\textasciigrave{}}\NormalTok{)}\OperatorTok{;}

\CommentTok{// Concatenation (older style)}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\StringTok{"Hello, "} \OperatorTok{+}\NormalTok{ name }\OperatorTok{+} \StringTok{"! You are "} \OperatorTok{+}\NormalTok{ age }\OperatorTok{+} \StringTok{" years old."}\NormalTok{)}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\subsection{Skills Checklist}\label{skills-checklist-54}

\begin{itemize}
\tightlist
\item[$\square$]
  I can use \texttt{console.log()} to display output.
\item[$\square$]
  I can declare variables using \texttt{const} and \texttt{let}.
\item[$\square$]
  I can use template literals with \texttt{\$\{\}}.
\end{itemize}

\begin{center}\rule{0.5\linewidth}{0.5pt}\end{center}

\subsection{Lesson 1.3: Data Types}\label{lesson-1.3-data-types}

\subsection{Primitive Types}\label{primitive-types}

\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{// Number (integers and floats use the same type)}
\KeywordTok{let}\NormalTok{ integer }\OperatorTok{=} \DecValTok{42}\OperatorTok{;}
\KeywordTok{let}\NormalTok{ decimal }\OperatorTok{=} \FloatTok{3.14}\OperatorTok{;}
\KeywordTok{let}\NormalTok{ negative }\OperatorTok{=} \OperatorTok{{-}}\DecValTok{10}\OperatorTok{;}

\CommentTok{// String}
\KeywordTok{let}\NormalTok{ name }\OperatorTok{=} \StringTok{"Alice"}\OperatorTok{;}
\KeywordTok{let}\NormalTok{ greeting }\OperatorTok{=} \StringTok{"Hello"}\OperatorTok{;}
\KeywordTok{let}\NormalTok{ multiLine }\OperatorTok{=} \VerbatimStringTok{\textasciigrave{}Line 1}
\VerbatimStringTok{Line 2\textasciigrave{}}\OperatorTok{;}

\CommentTok{// Boolean}
\KeywordTok{let}\NormalTok{ isRaining }\OperatorTok{=} \KeywordTok{false}\OperatorTok{;}
\KeywordTok{let}\NormalTok{ isLoggedIn }\OperatorTok{=} \KeywordTok{true}\OperatorTok{;}

\CommentTok{// null (intentional absence of value)}
\KeywordTok{let}\NormalTok{ emptyValue }\OperatorTok{=} \KeywordTok{null}\OperatorTok{;}

\CommentTok{// undefined (value not assigned)}
\KeywordTok{let}\NormalTok{ notAssigned}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(notAssigned)}\OperatorTok{;} \CommentTok{// undefined}

\CommentTok{// Check type}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\KeywordTok{typeof} \DecValTok{42}\NormalTok{)}\OperatorTok{;} \CommentTok{// "number"}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\KeywordTok{typeof} \StringTok{"hello"}\NormalTok{)}\OperatorTok{;} \CommentTok{// "string"}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\KeywordTok{typeof} \KeywordTok{true}\NormalTok{)}\OperatorTok{;} \CommentTok{// "boolean"}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\KeywordTok{typeof} \KeywordTok{null}\NormalTok{)}\OperatorTok{;} \CommentTok{// "object" (known quirk!)}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\KeywordTok{typeof} \KeywordTok{undefined}\NormalTok{)}\OperatorTok{;} \CommentTok{// "undefined"}
\end{Highlighting}
\end{Shaded}

\subsection{Arithmetic Operators}\label{arithmetic-operators}

\begin{Shaded}
\begin{Highlighting}[]
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\DecValTok{5} \OperatorTok{+} \DecValTok{3}\NormalTok{)}\OperatorTok{;} \CommentTok{// 8}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\DecValTok{10} \OperatorTok{{-}} \DecValTok{4}\NormalTok{)}\OperatorTok{;} \CommentTok{// 6}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\DecValTok{7} \OperatorTok{*} \DecValTok{6}\NormalTok{)}\OperatorTok{;} \CommentTok{// 42}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\DecValTok{15} \OperatorTok{/} \DecValTok{4}\NormalTok{)}\OperatorTok{;} \CommentTok{// 3.75  (always decimal, unlike Python 2 or Java)}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\DecValTok{10} \OperatorTok{\%} \DecValTok{3}\NormalTok{)}\OperatorTok{;} \CommentTok{// 1  (remainder)}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\DecValTok{2} \OperatorTok{**} \DecValTok{10}\NormalTok{)}\OperatorTok{;} \CommentTok{// 1024  (exponentiation)}

\CommentTok{// Math.floor for integer division equivalent}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Math}\OperatorTok{.}\FunctionTok{floor}\NormalTok{(}\DecValTok{15} \OperatorTok{/} \DecValTok{4}\NormalTok{))}\OperatorTok{;} \CommentTok{// 3}
\end{Highlighting}
\end{Shaded}

\subsection{Type Conversion}\label{type-conversion}

\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{// String to Number}
\KeywordTok{let}\NormalTok{ str }\OperatorTok{=} \StringTok{"123"}\OperatorTok{;}
\KeywordTok{let}\NormalTok{ num }\OperatorTok{=} \BuiltInTok{Number}\NormalTok{(str)}\OperatorTok{;} \CommentTok{// 123}
\KeywordTok{let}\NormalTok{ numParsed }\OperatorTok{=} \PreprocessorTok{parseInt}\NormalTok{(str)}\OperatorTok{;} \CommentTok{// 123}
\KeywordTok{let}\NormalTok{ floatParsed }\OperatorTok{=} \PreprocessorTok{parseFloat}\NormalTok{(}\StringTok{"3.14"}\NormalTok{)}\OperatorTok{;} \CommentTok{// 3.14}

\CommentTok{// Number to String}
\KeywordTok{let}\NormalTok{ n }\OperatorTok{=} \DecValTok{42}\OperatorTok{;}
\KeywordTok{let}\NormalTok{ s }\OperatorTok{=} \BuiltInTok{String}\NormalTok{(n)}\OperatorTok{;} \CommentTok{// "42"}
\KeywordTok{let}\NormalTok{ s2 }\OperatorTok{=}\NormalTok{ n}\OperatorTok{.}\FunctionTok{toString}\NormalTok{()}\OperatorTok{;} \CommentTok{// "42"}
\KeywordTok{let}\NormalTok{ s3 }\OperatorTok{=} \VerbatimStringTok{\textasciigrave{}}\SpecialCharTok{$\{}\NormalTok{n}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\OperatorTok{;} \CommentTok{// "42" (template literal)}

\CommentTok{// Checking}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\PreprocessorTok{isNaN}\NormalTok{(}\StringTok{"abc"}\NormalTok{))}\OperatorTok{;} \CommentTok{// true {-}{-}{-} "not a number"}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\PreprocessorTok{isNaN}\NormalTok{(}\DecValTok{42}\NormalTok{))}\OperatorTok{;} \CommentTok{// false}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\BuiltInTok{Number}\NormalTok{(}\StringTok{"abc"}\NormalTok{))}\OperatorTok{;} \CommentTok{// NaN}
\end{Highlighting}
\end{Shaded}

\subsection{Constants}\label{constants}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ MAX\_SIZE }\OperatorTok{=} \DecValTok{100}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ APP\_NAME }\OperatorTok{=} \StringTok{"My App"}\OperatorTok{;}
\KeywordTok{const} \ConstantTok{PI} \OperatorTok{=} \BuiltInTok{Math}\OperatorTok{.}\ConstantTok{PI}\OperatorTok{;} \CommentTok{// Use Math.PI {-}{-}{-} already defined}
\end{Highlighting}
\end{Shaded}

\subsection{Examples}\label{examples-14}

\textbf{Example 1.3.1: Personal Information}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ myName }\OperatorTok{=} \StringTok{"Jamie"}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ favoriteNumber }\OperatorTok{=} \DecValTok{7}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ heightInMeters }\OperatorTok{=} \FloatTok{1.75}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ likesPizza }\OperatorTok{=} \KeywordTok{true}\OperatorTok{;}

\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Name: }\SpecialCharTok{$\{}\NormalTok{myName}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Favorite number: }\SpecialCharTok{$\{}\NormalTok{favoriteNumber}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Height: }\SpecialCharTok{$\{}\NormalTok{heightInMeters}\SpecialCharTok{\}}\VerbatimStringTok{ meters\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Likes pizza: }\SpecialCharTok{$\{}\NormalTok{likesPizza}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\textbf{Example 1.3.2: Simple Math}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ num1 }\OperatorTok{=} \DecValTok{15}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ num2 }\OperatorTok{=} \DecValTok{7}\OperatorTok{;}

\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Sum: }\SpecialCharTok{$\{}\NormalTok{num1 }\OperatorTok{+}\NormalTok{ num2}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Difference: }\SpecialCharTok{$\{}\NormalTok{num1 }\OperatorTok{{-}}\NormalTok{ num2}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Product: }\SpecialCharTok{$\{}\NormalTok{num1 }\OperatorTok{*}\NormalTok{ num2}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Quotient: }\SpecialCharTok{$\{}\NormalTok{(num1 }\OperatorTok{/}\NormalTok{ num2)}\OperatorTok{.}\FunctionTok{toFixed}\NormalTok{(}\DecValTok{2}\NormalTok{)}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Remainder: }\SpecialCharTok{$\{}\NormalTok{num1 }\OperatorTok{\%}\NormalTok{ num2}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

\subsection{Activities}\label{activities-12}

\textbf{Activity 1.3.1: Area Calculator}

\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{const}\NormalTok{ length }\OperatorTok{=} \DecValTok{12}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ width }\OperatorTok{=} \DecValTok{5}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ height }\OperatorTok{=} \DecValTok{8}\OperatorTok{;}

\KeywordTok{const}\NormalTok{ rectangleArea }\OperatorTok{=}\NormalTok{ length }\OperatorTok{*}\NormalTok{ width}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ boxVolume }\OperatorTok{=}\NormalTok{ length }\OperatorTok{*}\NormalTok{ width }\OperatorTok{*}\NormalTok{ height}\OperatorTok{;}
\KeywordTok{const}\NormalTok{ circleArea }\OperatorTok{=} \BuiltInTok{Math}\OperatorTok{.}\ConstantTok{PI} \OperatorTok{*}\NormalTok{ (length }\OperatorTok{/} \DecValTok{2}\NormalTok{) }\OperatorTok{**} \DecValTok{2}\OperatorTok{;}

\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Rectangle area: }\SpecialCharTok{$\{}\NormalTok{rectangleArea}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Box volume: }\SpecialCharTok{$\{}\NormalTok{boxVolume}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\BuiltInTok{console}\OperatorTok{.}\FunctionTok{log}\NormalTok{(}\VerbatimStringTok{\textasciigrave{}Circle area: }\SpecialCharTok{$\{}\NormalTok{circleArea}\OperatorTok{.}\FunctionTok{toFixed}\NormalTok{(}\DecValTok{2}\NormalTok{)}\SpecialCharTok{\}}\VerbatimStringTok{\textasciigrave{}}\NormalTok{)}\OperatorTok{;}
\end{Highlighting}
\end{Shaded}

