\subsection{Lesson 2.3: Input and Output
Revisited}\label{lesson-2.3-input-and-output-revisited}

\subsection{Reading References}\label{reading-references-9}

\begin{itemize}
\tightlist
\item
  Zelle: Chapter 2, pages 27--33
\item
  Matthes: Chapter 7, pages 114--116
\end{itemize}

\subsection{\texorpdfstring{The \texttt{input()}
Function}{The input() Function}}\label{the-input-function}

The \texttt{input()} function pauses program execution and waits for the
user to type something and press Enter. \textbf{It always returns a
string.}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{user\_name }\OperatorTok{=} \BuiltInTok{input}\NormalTok{(}\StringTok{"What is your name? "}\NormalTok{)}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Hello, }\SpecialCharTok{\{}\NormalTok{user\_name}\SpecialCharTok{\}}\SpecialStringTok{! Nice to meet you."}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

\subsection{F-Strings (Formatted String
Literals)}\label{f-strings-formatted-string-literals}

F-strings provide a clean way to embed variable values directly into a
string:

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{name }\OperatorTok{=} \StringTok{"Alice"}
\NormalTok{age }\OperatorTok{=} \DecValTok{30}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Hello, }\SpecialCharTok{\{}\NormalTok{name}\SpecialCharTok{\}}\SpecialStringTok{! You are }\SpecialCharTok{\{}\NormalTok{age}\SpecialCharTok{\}}\SpecialStringTok{ years old."}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

\subsection{Converting Input for
Calculations}\label{converting-input-for-calculations}

Since \texttt{input()} always returns a string, you must convert it for
math:

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{age\_str }\OperatorTok{=} \BuiltInTok{input}\NormalTok{(}\StringTok{"How old are you? "}\NormalTok{)}
\NormalTok{age\_int }\OperatorTok{=} \BuiltInTok{int}\NormalTok{(age\_str)}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Next year you will be }\SpecialCharTok{\{}\NormalTok{age\_int }\OperatorTok{+} \DecValTok{1}\SpecialCharTok{\}}\SpecialStringTok{ years old."}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

\subsection{Examples}\label{examples-3}

\textbf{Example 2.3.1: Basic Input}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{user\_name }\OperatorTok{=} \BuiltInTok{input}\NormalTok{(}\StringTok{"What is your name? "}\NormalTok{)}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Hello, }\SpecialCharTok{\{}\NormalTok{user\_name}\SpecialCharTok{\}}\SpecialStringTok{! Nice to meet you."}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

\textbf{Example 2.3.2: Numeric Input and Calculation}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{num1\_str }\OperatorTok{=} \BuiltInTok{input}\NormalTok{(}\StringTok{"Enter the first number: "}\NormalTok{)}
\NormalTok{num1 }\OperatorTok{=} \BuiltInTok{int}\NormalTok{(num1\_str)}

\NormalTok{num2\_str }\OperatorTok{=} \BuiltInTok{input}\NormalTok{(}\StringTok{"Enter the second number: "}\NormalTok{)}
\NormalTok{num2 }\OperatorTok{=} \BuiltInTok{int}\NormalTok{(num2\_str)}

\NormalTok{sum\_result }\OperatorTok{=}\NormalTok{ num1 }\OperatorTok{+}\NormalTok{ num2}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"The sum of }\SpecialCharTok{\{}\NormalTok{num1}\SpecialCharTok{\}}\SpecialStringTok{ and }\SpecialCharTok{\{}\NormalTok{num2}\SpecialCharTok{\}}\SpecialStringTok{ is }\SpecialCharTok{\{}\NormalTok{sum\_result}\SpecialCharTok{\}}\SpecialStringTok{."}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

\subsection{Activities}\label{activities-4}

\textbf{Activity 2.3.1: Temperature Converter}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{fahrenheit\_str }\OperatorTok{=} \BuiltInTok{input}\NormalTok{(}\StringTok{"Enter temperature in Fahrenheit: "}\NormalTok{)}
\NormalTok{fahrenheit }\OperatorTok{=} \BuiltInTok{float}\NormalTok{(fahrenheit\_str)}
\NormalTok{celsius }\OperatorTok{=}\NormalTok{ (fahrenheit }\OperatorTok{{-}} \DecValTok{32}\NormalTok{) }\OperatorTok{*} \DecValTok{5} \OperatorTok{/} \DecValTok{9}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"}\SpecialCharTok{\{}\NormalTok{fahrenheit}\SpecialCharTok{\}}\SpecialStringTok{°F is }\SpecialCharTok{\{}\NormalTok{celsius}\SpecialCharTok{:.2f\}}\SpecialStringTok{°C"}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

