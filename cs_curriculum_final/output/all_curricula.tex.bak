\subsection{Lesson 2.5: Using the Math
Library}\label{lesson-2.5-using-the-math-library}

\subsection{Reading References}\label{reading-references-11}

\begin{itemize}
\tightlist
\item
  Zelle: Chapter 3, pages 49--51
\end{itemize}

\subsection{Importing the Math
Module}\label{importing-the-math-module}

\begin{Shaded}
\begin{Highlighting}[]
\ImportTok{import}\NormalTok{ math}
\end{Highlighting}
\end{Shaded}

\subsection{Key Math Functions and
Constants}\label{key-math-functions-and-constants}

{\def\LTcaptype{none} % do not increment counter
\begin{longtable}[]{@{}
  >{\raggedright\arraybackslash}p{(\linewidth - 4\tabcolsep) * \real{0.2533}}
  >{\raggedright\arraybackslash}p{(\linewidth - 4\tabcolsep) * \real{0.3467}}
  >{\raggedright\arraybackslash}p{(\linewidth - 4\tabcolsep) * \real{0.4000}}@{}}
\toprule\noalign{}
\begin{minipage}[b]{\linewidth}\raggedright
Function/Constant
\end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
Description
\end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
Example
\end{minipage} \\
\midrule\noalign{}
\endhead
\bottomrule\noalign{}
\endlastfoot
\texttt{math.pi} & π ≈ 3.14159 & \texttt{math.pi} \\
\texttt{math.e} & e ≈ 2.71828 & \texttt{math.e} \\
\texttt{math.sqrt(x)} & Square root of x & \texttt{math.sqrt(25)}
-\textgreater{} \texttt{5.0} \\
\texttt{math.pow(x,\ y)} & x raised to power y &
\texttt{math.pow(2,\ 4)} -\textgreater{} \texttt{16.0} \\
\texttt{math.ceil(x)} & Round up & \texttt{math.ceil(4.2)}
-\textgreater{} \texttt{5} \\
\texttt{math.floor(x)} & Round down & \texttt{math.floor(4.8)}
-\textgreater{} \texttt{4} \\
\texttt{math.log(x,\ base)} & Logarithm & \texttt{math.log(100,\ 10)}
-\textgreater{} \texttt{2.0} \\
\texttt{math.sin(x)} & Sine (in radians) & \texttt{math.sin(math.pi/2)}
-\textgreater{} \texttt{1.0} \\
\texttt{math.radians(deg)} & Convert degrees to radians &
\texttt{math.radians(90)} \\
\end{longtable}
}

\subsection{Examples}\label{examples-5}

\textbf{Example 2.5.1: Circle Calculations}

\begin{Shaded}
\begin{Highlighting}[]
\ImportTok{import}\NormalTok{ math}

\NormalTok{radius }\OperatorTok{=} \DecValTok{5}
\NormalTok{area }\OperatorTok{=}\NormalTok{ math.pi }\OperatorTok{*}\NormalTok{ radius }\OperatorTok{**} \DecValTok{2}
\NormalTok{circumference }\OperatorTok{=} \DecValTok{2} \OperatorTok{*}\NormalTok{ math.pi }\OperatorTok{*}\NormalTok{ radius}

\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Area of circle with radius }\SpecialCharTok{\{}\NormalTok{radius}\SpecialCharTok{\}}\SpecialStringTok{: }\SpecialCharTok{\{}\NormalTok{area}\SpecialCharTok{:.2f\}}\SpecialStringTok{"}\NormalTok{)}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Circumference: }\SpecialCharTok{\{}\NormalTok{circumference}\SpecialCharTok{:.2f\}}\SpecialStringTok{"}\NormalTok{)}

\NormalTok{number }\OperatorTok{=} \DecValTok{81}
\NormalTok{square\_root }\OperatorTok{=}\NormalTok{ math.sqrt(number)}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Square root of }\SpecialCharTok{\{}\NormalTok{number}\SpecialCharTok{\}}\SpecialStringTok{: }\SpecialCharTok{\{}\NormalTok{square\_root}\SpecialCharTok{\}}\SpecialStringTok{"}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

\subsection{Activities}\label{activities-6}

\textbf{Activity 2.5.1: Circle Calculator}

\begin{Shaded}
\begin{Highlighting}[]
