\subsection{Lesson 2.4: Computing with Numbers and Type
Conversions}\label{lesson-2.4-computing-with-numbers-and-type-conversions}

\subsection{Reading References}\label{reading-references-10}

\begin{itemize}
\tightlist
\item
  Zelle: Chapter 3, pages 41--48
\item
  Matthes: Chapter 2, pages 26--28
\end{itemize}

\subsection{Integers and Floats}\label{integers-and-floats}

{\def\LTcaptype{none} % do not increment counter
\begin{longtable}[]{@{}lll@{}}
\toprule\noalign{}
Type & Description & Example \\
\midrule\noalign{}
\endhead
\bottomrule\noalign{}
\endlastfoot
\texttt{int} & Whole numbers (exact) & \texttt{5}, \texttt{-20},
\texttt{1000000} \\
\texttt{float} & Numbers with decimals & \texttt{3.14}, \texttt{-2.5},
\texttt{6.0} \\
\end{longtable}
}

\textbf{Key behaviors:}

\begin{itemize}
\tightlist
\item
  Division \texttt{/} always returns a float: \texttt{10\ /\ 2}
  -\textgreater{} \texttt{5.0}
\item
  Floor division \texttt{//} returns the integer part:
  \texttt{10\ //\ 3} -\textgreater{} \texttt{3}
\item
  Mixed operations promote to float: \texttt{10\ +\ 3.5} -\textgreater{}
  \texttt{13.5}
\end{itemize}

\subsection{Type Conversion
Functions}\label{type-conversion-functions}

\begin{Shaded}
\begin{Highlighting}[]
\BuiltInTok{int}\NormalTok{(}\StringTok{"123"}\NormalTok{)      }\CommentTok{\# {-}\textgreater{} 123  (truncates: int(3.9) {-}\textgreater{} 3)}
\BuiltInTok{float}\NormalTok{(}\StringTok{"3.14"}\NormalTok{)   }\CommentTok{\# {-}\textgreater{} 3.14}
\BuiltInTok{str}\NormalTok{(}\DecValTok{42}\NormalTok{)         }\CommentTok{\# {-}\textgreater{} "42"}
\end{Highlighting}
\end{Shaded}

\subsection{Examples}\label{examples-4}

\textbf{Example 2.4.1: Type Conversion}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{num\_str }\OperatorTok{=} \StringTok{"123"}
\NormalTok{num\_int }\OperatorTok{=} \BuiltInTok{int}\NormalTok{(num\_str)}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"String \textquotesingle{}}\SpecialCharTok{\{}\NormalTok{num\_str}\SpecialCharTok{\}}\SpecialStringTok{\textquotesingle{} as integer: }\SpecialCharTok{\{}\NormalTok{num\_int}\SpecialCharTok{\}}\SpecialStringTok{, type: }\SpecialCharTok{\{}\BuiltInTok{type}\NormalTok{(num\_int)}\SpecialCharTok{\}}\SpecialStringTok{"}\NormalTok{)}

\NormalTok{num\_float }\OperatorTok{=} \BuiltInTok{float}\NormalTok{(num\_str)}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"String \textquotesingle{}}\SpecialCharTok{\{}\NormalTok{num\_str}\SpecialCharTok{\}}\SpecialStringTok{\textquotesingle{} as float: }\SpecialCharTok{\{}\NormalTok{num\_float}\SpecialCharTok{\}}\SpecialStringTok{, type: }\SpecialCharTok{\{}\BuiltInTok{type}\NormalTok{(num\_float)}\SpecialCharTok{\}}\SpecialStringTok{"}\NormalTok{)}

\NormalTok{my\_number }\OperatorTok{=} \DecValTok{42}
\NormalTok{my\_text }\OperatorTok{=} \BuiltInTok{str}\NormalTok{(my\_number)}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Integer }\SpecialCharTok{\{}\NormalTok{my\_number}\SpecialCharTok{\}}\SpecialStringTok{ as string: \textquotesingle{}}\SpecialCharTok{\{}\NormalTok{my\_text}\SpecialCharTok{\}}\SpecialStringTok{\textquotesingle{}, type: }\SpecialCharTok{\{}\BuiltInTok{type}\NormalTok{(my\_text)}\SpecialCharTok{\}}\SpecialStringTok{"}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

\textbf{Common Type Error:}

\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{\# This will cause a TypeError:}
\CommentTok{\# print("My age is " + 14)}
\CommentTok{\# Fix: print("My age is " + str(14))}
\CommentTok{\# Or: print(f"My age is \{14\}")}
\end{Highlighting}
\end{Shaded}

\subsection{Activities}\label{activities-5}

\textbf{Activity 2.4.1: Mixed Bag Calculator}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{age\_str }\OperatorTok{=} \BuiltInTok{input}\NormalTok{(}\StringTok{"Enter your age: "}\NormalTok{)}
\NormalTok{age }\OperatorTok{=} \BuiltInTok{int}\NormalTok{(age\_str)}

\NormalTok{weight\_str }\OperatorTok{=} \BuiltInTok{input}\NormalTok{(}\StringTok{"Enter your weight in kg: "}\NormalTok{)}
\NormalTok{weight }\OperatorTok{=} \BuiltInTok{float}\NormalTok{(weight\_str)}

\NormalTok{phrase }\OperatorTok{=} \BuiltInTok{input}\NormalTok{(}\StringTok{"Enter a short phrase: "}\NormalTok{)}

\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Age doubled: }\SpecialCharTok{\{}\NormalTok{age }\OperatorTok{*} \DecValTok{2}\SpecialCharTok{\}}\SpecialStringTok{"}\NormalTok{)}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Weight + age: }\SpecialCharTok{\{}\NormalTok{weight }\OperatorTok{+}\NormalTok{ age}\SpecialCharTok{\}}\SpecialStringTok{"}\NormalTok{)}
\BuiltInTok{print}\NormalTok{(}\SpecialStringTok{f"Phrase length: }\SpecialCharTok{\{}\BuiltInTok{len}\NormalTok{(phrase)}\SpecialCharTok{\}}\SpecialStringTok{ characters"}\NormalTok{)}
\end{Highlighting}
\end{Shaded}

