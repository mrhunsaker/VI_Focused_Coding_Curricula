% --------------------------------------------------
% Syntax-highlighting token macros  (Tufte-harmonised palette)
%
% Design intent:
%   • Keywords      — brand blue, bold          (authoritative, structural)
%   • Strings       — warm teal                  (data / literals stand out)
%   • Comments      — light mid-gray, italic     (recede; readable but quiet)
%   • Numbers       — muted violet               (distinct from identifiers)
%   • Functions     — brand blue (no bold)       (callable things)
%   • Types/DataType— slightly darker blue-gray  (structural but not loud)
%   • Operators     — dark gray                  (punctuation-weight)
%   • Errors/Alerts — Tufte's red                (immediate attention)
%   • Preprocessor/ — brand accent (teal-ish)    (meta-level, distinct)
%     Import
%   • Everything else — inherits monospace black (default readable)
% --------------------------------------------------

% --- Colour additions for code palette ---
\definecolor{CodeBg}{RGB}{250,250,248}          % warm near-white background
\definecolor{CodeRule}{RGB}{18,65,124}           % brand blue left-rule accent
\definecolor{CodeComment}{RGB}{140,148,163}      % muted blue-gray (italic comments)
\definecolor{CodeString}{RGB}{0,120,100}         % deep teal for strings/chars
\definecolor{CodeNumber}{RGB}{110,60,160}        % soft violet for numeric literals
\definecolor{CodeKeyword}{RGB}{18,65,124}        % brand blue, bold
\definecolor{CodeType}{RGB}{55,90,140}           % mid blue-gray for types
\definecolor{CodeAccent}{RGB}{0,140,185}         % brand accent for import/preprocessor
\definecolor{CodeError}{RGB}{180,28,28}          % Tufte-red for errors

% --- Token macros ---
\newcommand{\AlertTok}[1]{\textcolor{CodeError}{\textbf{#1}}}
\newcommand{\AnnotationTok}[1]{\textcolor{CodeComment}{\textit{#1}}}
\newcommand{\AttributeTok}[1]{\textcolor{CodeType}{#1}}
\newcommand{\BaseNTok}[1]{\textcolor{CodeNumber}{#1}}
\newcommand{\BuiltInTok}[1]{#1}
\newcommand{\CharTok}[1]{\textcolor{CodeString}{#1}}
\newcommand{\CommentTok}[1]{\textcolor{CodeComment}{\textit{#1}}}
\newcommand{\CommentVarTok}[1]{\textcolor{CodeComment}{\textit{#1}}}
\newcommand{\ConstantTok}[1]{\textcolor{CodeNumber}{#1}}
\newcommand{\ControlFlowTok}[1]{\textcolor{CodeKeyword}{\textbf{#1}}}
\newcommand{\DataTypeTok}[1]{\textcolor{CodeType}{#1}}
\newcommand{\DecValTok}[1]{\textcolor{CodeNumber}{#1}}
\newcommand{\DocumentationTok}[1]{\textcolor{CodeComment}{\textit{#1}}}
\newcommand{\ErrorTok}[1]{\textcolor{CodeError}{\underline{#1}}}
\newcommand{\ExtensionTok}[1]{#1}
\newcommand{\FloatTok}[1]{\textcolor{CodeNumber}{#1}}
\newcommand{\FunctionTok}[1]{\textcolor{CodeKeyword}{#1}}
\newcommand{\ImportTok}[1]{\textcolor{CodeAccent}{#1}}
\newcommand{\InformationTok}[1]{\textcolor{CodeAccent}{\textit{#1}}}
\newcommand{\KeywordTok}[1]{\textcolor{CodeKeyword}{\textbf{#1}}}
\newcommand{\NormalTok}[1]{#1}
\newcommand{\OperatorTok}[1]{\textcolor{DarkGray}{#1}}
\newcommand{\OtherTok}[1]{#1}
\newcommand{\PreprocessorTok}[1]{\textcolor{CodeAccent}{#1}}
\newcommand{\RegionMarkerTok}[1]{#1}
\newcommand{\SpecialCharTok}[1]{\textcolor{CodeString}{#1}}
\newcommand{\SpecialStringTok}[1]{\textcolor{CodeString}{#1}}
\newcommand{\StringTok}[1]{\textcolor{CodeString}{#1}}
\newcommand{\VariableTok}[1]{#1}
\newcommand{\VerbatimStringTok}[1]{\textcolor{CodeString}{#1}}
\newcommand{\WarningTok}[1]{\textcolor{WarningAmber}{\textbf{#1}}}

% --- Safety net: any *Tok not listed above falls back to plain text ---
\makeatletter
\@for\tok:=Alert,Annotation,Attribute,BaseN,BuiltIn,Char,Comment,CommentVar,%
Constant,ControlFlow,DataType,DecVal,Documentation,Error,Extension,Float,%
Function,Import,Information,Keyword,Normal,Operator,Other,Preprocessor,%
RegionMarker,SpecialChar,SpecialString,String,Variable,VerbatimString,Warning%
\do{%
  \expandafter\providecommand\csname\tok Tok\endcsname[1]{#1}%
}
\makeatother

% --------------------------------------------------
% Code-block environments  (Tufte-native style)
%
% Visual design:
%   • 3 pt brand-blue left rule (Tufte accent, not a box)
%   • Warm near-white background (CodeBg)
%   • Modest left/right/top/bottom padding via mdframed
%   • Monospace font at \footnotesize (readable in Tufte text width)
%   • No heavy borders; top/bottom spacing handled by mdframed skip
% --------------------------------------------------
\usepackage{fancyvrb}
\usepackage[framemethod=default]{mdframed}

\mdfdefinestyle{TufteCode}{%
  backgroundcolor=CodeBg,
  linecolor=CodeRule,
  linewidth=2.5pt,
  leftline=true,
  rightline=false,
  topline=false,
  bottomline=false,
  innerleftmargin=10pt,
  innerrightmargin=8pt,
  innertopmargin=6pt,
  innerbottommargin=6pt,
  skipabove=\medskipamount,
  skipbelow=\medskipamount,
  splittopskip=\topskip,
  splitbottomskip=0pt,
  nobreak=false,
}

\newenvironment{Shaded}{%
  \begin{mdframed}[style=TufteCode]%
}{%
  \end{mdframed}%
}

% Highlighting: verbatim env inside Shaded; footnotesize suits Tufte column
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{%
  commandchars=\\\{\},%
  fontsize=\footnotesize,%
  baselinestretch=1.15,%
  xleftmargin=0pt%
}

